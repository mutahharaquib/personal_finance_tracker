<%- include('partials/app-start') %>
<% const barClass = function (pct) { return pct > 100 ? 'over' : pct >= 80 ? 'warn' : 'ok'; }; %>

<div class="page-header">
  <div>
    <h1>Budgets</h1>
    <p>Monthly spending limits — they reset automatically every month.</p>
  </div>
  <div class="page-actions">
    <div class="row" style="gap:4px">
      <a class="icon-btn" href="/budgets?month=<%= prevMonth %>" aria-label="Previous month"><i data-lucide="chevron-left"></i></a>
      <strong style="min-width:140px;text-align:center"><%= monthName %></strong>
      <a class="icon-btn" href="/budgets?month=<%= nextMonth %>" aria-label="Next month"><i data-lucide="chevron-right"></i></a>
    </div>
    <button type="button" class="btn btn-primary" data-open="budget-dialog"><i data-lucide="plus"></i>New budget</button>
  </div>
</div>

<section class="card">
  <div class="row-between" style="flex-wrap:wrap">
    <div>
      <div class="kpi-label">Overall monthly budget</div>
      <% if (monthlyBudget > 0) { %>
        <div class="kpi-value mt-1"><%= fmt(totalSpent) %> <span class="muted" style="font-size:1rem;font-weight:500">of <%= fmt(monthlyBudget) %></span></div>
      <% } else { %>
        <div class="mt-1 muted">Not set — <%= fmt(totalSpent) %> spent this month.</div>
      <% } %>
    </div>
    <form action="/budgets/overall" method="POST" class="row" style="gap:8px">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label for="overall" class="sr-only">Overall monthly budget</label>
      <input class="input num" id="overall" name="monthlyBudget" type="number" min="0" step="0.01" placeholder="e.g. 30000" value="<%= monthlyBudget || '' %>" style="width:160px">
      <button class="btn btn-secondary">Save</button>
    </form>
  </div>
  <% if (monthlyBudget > 0) { %>
    <div class="progress progress-lg mt-2 <%= barClass(overallPct) %>"><span style="width:<%= Math.min(100, overallPct) %>%"></span></div>
    <div class="row-between mt-1 small muted">
      <span><%= overallPct %>% used</span>
      <% if (isCurrent && monthlyBudget > totalSpent) { %>
        <span><%= fmt(monthlyBudget - totalSpent) %> left · about <%= fmt((monthlyBudget - totalSpent) / daysLeft) %>/day for <%= daysLeft %> day<%= daysLeft === 1 ? '' : 's' %></span>
      <% } else if (totalSpent > monthlyBudget) { %>
        <span class="text-expense">Over by <%= fmt(totalSpent - monthlyBudget) %></span>
      <% } %>
    </div>
  <% } %>
</section>

<% if (rows.length) { %>
  <div class="grid grid-3 mt-2">
    <% rows.forEach(function (b) { %>
      <section class="card budget-item" style="margin:0;border-top:1px solid var(--border);padding-top:20px">
        <div class="row-between">
          <div class="row" style="min-width:0">
            <span class="cat-icon" style="--c:<%= b.meta.color %>"><i data-lucide="<%= b.meta.icon %>"></i></span>
            <div style="min-width:0">
              <h3 class="truncate"><%= b.category %></h3>
              <div class="small muted"><%= fmt(b.amount) %> / month</div>
            </div>
          </div>
          <div class="row" style="gap:0">
            <button type="button" class="icon-btn" aria-label="Edit budget" data-open="budget-dialog" data-budget-category="<%= b.category %>" data-budget-amount="<%= b.amount %>"><i data-lucide="pencil"></i></button>
            <form action="/budgets/<%= b._id %>/delete" method="POST" data-confirm="Remove the <%= b.category %> budget?">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="icon-btn danger" aria-label="Remove budget"><i data-lucide="trash"></i></button>
            </form>
          </div>
        </div>
        <div class="kpi-value" style="font-size:1.3rem"><%= fmt(b.spent) %> <span class="small muted" style="font-weight:500">spent</span></div>
        <div class="progress <%= barClass(b.pct) %>"><span style="width:<%= Math.min(100, b.pct) %>%"></span></div>
        <div class="row-between small">
          <span class="muted"><%= b.pct %>%</span>
          <% if (b.remaining >= 0) { %>
            <span class="<%= b.pct >= 80 ? 'text-warning' : 'muted' %>"><%= fmt(b.remaining) %> left</span>
          <% } else { %>
            <span class="text-expense"><i data-lucide="triangle-alert" style="display:inline;width:14px;height:14px;vertical-align:-2px"></i> <%= fmt(-b.remaining) %> over</span>
          <% } %>
        </div>
      </section>
    <% }) %>
  </div>
<% } else { %>
  <section class="card mt-2">
    <div class="empty">
      <span class="kpi-icon tone-primary"><i data-lucide="wallet"></i></span>
      <h3>No category budgets yet</h3>
      <p>Pick a category like Food or Shopping and set a monthly limit. We'll show how much is left and warn you at 80%.</p>
      <button type="button" class="btn btn-primary" data-open="budget-dialog"><i data-lucide="plus"></i>Create your first budget</button>
    </div>
  </section>
<% } %>

<% if (unbudgeted.length) { %>
  <section class="card card-flush mt-2">
    <div class="card-header"><h2>Spending without a budget</h2><span class="muted small"><%= monthName %></span></div>
    <ul class="tx-list mt-1">
      <% unbudgeted.forEach(function (u) { %>
        <li class="tx-item">
          <span class="cat-icon sm" style="--c:<%= u.meta.color %>"><i data-lucide="<%= u.meta.icon %>"></i></span>
          <div class="tx-main"><div class="tx-title truncate"><%= u.category %></div><div class="tx-meta"><%= u.count %> transaction<%= u.count === 1 ? '' : 's' %></div></div>
          <div class="tx-amount"><%= fmt(u.total) %></div>
          <button type="button" class="btn btn-ghost btn-sm" data-open="budget-dialog" data-budget-category="<%= u.category %>">Set budget</button>
        </li>
      <% }) %>
    </ul>
  </section>
<% } %>

<dialog class="modal" id="budget-dialog" aria-labelledby="budget-title">
  <div class="modal-header">
    <h2 id="budget-title">Category budget</h2>
    <button type="button" class="icon-btn" data-close aria-label="Close"><i data-lucide="x"></i></button>
  </div>
  <div class="modal-body">
    <form action="/budgets" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="stack" style="gap:14px">
        <div class="field">
          <label for="b-category">Category</label>
          <select class="select" id="b-category" name="category" required>
            <% availableCategories.forEach(function (c) { %><option value="<%= c.name %>"><%= c.name %></option><% }) %>
          </select>
        </div>
        <div class="field">
          <label for="b-amount">Monthly limit</label>
          <input class="input num" id="b-amount" name="amount" type="number" min="0.01" step="0.01" required placeholder="e.g. 5000">
          <span class="hint">Setting a budget for a category that already has one updates it.</span>
        </div>
      </div>
      <div class="form-actions">
        <button type="button" class="btn btn-ghost" data-close>Cancel</button>
        <button class="btn btn-primary"><i data-lucide="check"></i>Save budget</button>
      </div>
    </form>
  </div>
</dialog>

<%- include('partials/app-end') %>
