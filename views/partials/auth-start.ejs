<%- include('head') %>
<body>
  <div class="auth">
    <div class="auth-form">
      <div class="inner">
        <div class="row-between">
          <a href="/" class="brand" style="padding:0"><span class="brand-mark"><i data-lucide="chart-no-axes-combined"></i></span>FinTrac</a>
          <button type="button" class="icon-btn" data-theme-toggle aria-label="Toggle dark mode"><span data-theme-icon><i data-lucide="moon"></i></span></button>
        </div>
        <% if (flash && flash.length) { %>
          <div class="mt-3" role="alert">
            <% flash.forEach(function (f) { %>
              <div class="alert alert-<%= f.type %>"><i data-lucide="<%= f.type === 'success' ? 'circle-check' : f.type === 'error' ? 'circle-x' : 'info' %>"></i><span><%= f.message %></span></div>
            <% }) %>
          </div>
        <% } %>
