<%- include('partials/app-start') %>
<%
  const changeBadge = function (value, goodWhenUp) {
    if (value === null) return '';
    const up = value > 0;
    const good = goodWhenUp ? up : !up;
    return '<span class="badge ' + (value === 0 ? '' : good ? 'badge-income' : 'badge-expense') + '">' + (up ? '▲ ' : value < 0 ? '▼ ' : '') + Math.abs(value) + '%</span> vs previous period';
  };
%>

<div class="page-header">
  <div>
    <h1>Reports</h1>
    <p><%= rangeLabel %></p>
  </div>
  <div class="page-actions">
    <a href="<%= exportUrl %>" class="btn btn-secondary"><i data-lucide="download"></i>Export this range</a>
  </div>
</div>

<div class="card row" style="flex-wrap:wrap;gap:10px;align-items:flex-end;justify-content:space-between">
  <form method="GET" action="/reports" class="field" style="min-width:200px">
    <label for="range">Period</label>
    <select class="select" id="range" name="range" data-autosubmit>
      <% Object.keys(presets).forEach(function (k) { %>
        <% if (k !== 'custom' || range === 'custom') { %>
          <option value="<%= k %>" <%= range === k ? 'selected' : '' %>><%= presets[k] %></option>
        <% } %>
      <% }) %>
    </select>
    <noscript><button class="btn btn-secondary btn-sm mt-1">Show</button></noscript>
  </form>
  <form method="GET" action="/reports" class="row" style="flex-wrap:wrap;gap:10px;align-items:flex-end">
    <input type="hidden" name="range" value="custom">
    <div class="field">
      <label for="r-from">From</label>
      <input class="input" type="date" id="r-from" name="from" value="<%= fromInput %>" required>
    </div>
    <div class="field">
      <label for="r-to">To</label>
      <input class="input" type="date" id="r-to" name="to" value="<%= toInput %>" required>
    </div>
    <button class="btn btn-secondary">Apply dates</button>
  </form>
</div>

<section class="grid grid-4 mt-2">
  <div class="card kpi">
    <div class="kpi-top"><span class="kpi-label">Income</span><span class="kpi-icon tone-income"><i data-lucide="arrow-down-left"></i></span></div>
    <div class="kpi-value text-income"><%= fmt(current.income) %></div>
    <div class="kpi-sub"><%- changeBadge(changes.income, true) %></div>
  </div>
  <div class="card kpi">
    <div class="kpi-top"><span class="kpi-label">Expenses</span><span class="kpi-icon tone-expense"><i data-lucide="arrow-up-right"></i></span></div>
    <div class="kpi-value text-expense"><%= fmt(current.expense) %></div>
    <div class="kpi-sub"><%- changeBadge(changes.expense, false) %></div>
  </div>
  <div class="card kpi">
    <div class="kpi-top"><span class="kpi-label">Net savings</span><span class="kpi-icon tone-primary"><i data-lucide="piggy-bank"></i></span></div>
    <div class="kpi-value"><%= fmt(current.net) %></div>
    <div class="kpi-sub">Savings rate: <%= savingsRate === null ? '—' : savingsRate + '%' %></div>
  </div>
  <div class="card kpi">
    <div class="kpi-top"><span class="kpi-label">Avg. daily spend</span><span class="kpi-icon tone-warning"><i data-lucide="calendar-days"></i></span></div>
    <div class="kpi-value"><%= fmt(avgDaily) %></div>
    <div class="kpi-sub"><%= current.count %> transaction<%= current.count === 1 ? '' : 's' %></div>
  </div>
</section>

<% if (current.count === 0) { %>
  <section class="card mt-2">
    <div class="empty">
      <span class="kpi-icon tone-primary"><i data-lucide="chart-column"></i></span>
      <h3>No data for this period</h3>
      <p>Pick a different period, or add some transactions to see your reports.</p>
    </div>
  </section>
<% } else { %>
  <section class="card mt-2">
    <div class="card-header"><h2>Income vs expenses</h2><span class="muted small"><%= cumulative ? 'Running total' : 'Per month' %></span></div>
    <div class="chart-box"><canvas data-chart="trend" role="img" aria-label="Income and expenses over time"></canvas></div>
  </section>

  <div class="grid grid-2 mt-2">
    <section class="card">
      <div class="card-header"><h2>Where your money went</h2></div>
      <% if (expenseCats.length) { %>
        <div class="chart-box sm"><canvas data-chart="categories" role="img" aria-label="Expenses by category"></canvas></div>
        <div class="stack mt-2" style="gap:12px">
          <% expenseCats.forEach(function (c) { %>
            <div>
              <div class="row-between small" style="margin-bottom:6px">
                <span class="row" style="gap:8px;min-width:0"><span class="cat-icon sm" style="--c:<%= c.meta.color %>"><i data-lucide="<%= c.meta.icon %>"></i></span><span class="truncate" style="font-weight:600"><%= c.category %></span></span>
                <span class="num nowrap"><strong><%= fmt(c.total) %></strong> <span class="muted"><%= c.pct %>%</span></span>
              </div>
              <div class="progress"><span style="width:<%= c.pct %>%;background:<%= c.meta.color %>"></span></div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <p class="muted small">No expenses in this period.</p>
      <% } %>
    </section>

    <div class="stack">
      <section class="card card-flush">
        <div class="card-header"><h2>Largest expenses</h2></div>
        <% if (topExpenses.length) { %>
          <ul class="tx-list mt-1">
            <% topExpenses.forEach(function (t) { %><%- include('partials/tx-item', { t: t, actions: false }) %><% }) %>
          </ul>
        <% } else { %>
          <p class="muted small" style="padding:0 20px 20px">No expenses in this period.</p>
        <% } %>
      </section>

      <section class="card">
        <div class="card-header"><h2>Income sources</h2></div>
        <% if (incomeCats.length) { %>
          <div class="stack" style="gap:12px">
            <% incomeCats.forEach(function (c) { %>
              <div>
                <div class="row-between small" style="margin-bottom:6px">
                  <span class="row" style="gap:8px;min-width:0"><span class="cat-icon sm" style="--c:<%= c.meta.color %>"><i data-lucide="<%= c.meta.icon %>"></i></span><span class="truncate" style="font-weight:600"><%= c.category %></span></span>
                  <span class="num nowrap"><strong><%= fmt(c.total) %></strong> <span class="muted"><%= c.pct %>%</span></span>
                </div>
                <div class="progress ok"><span style="width:<%= c.pct %>%"></span></div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <p class="muted small">No income in this period.</p>
        <% } %>
      </section>
    </div>
  </div>
<% } %>

<%- include('partials/app-end') %>
