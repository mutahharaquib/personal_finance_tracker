<%- include('partials/app-start') %>
<%
  const firstName = currentUser.name.split(' ')[0];
  const barClass = function (pct) { return pct > 100 ? 'over' : pct >= 80 ? 'warn' : 'ok'; };
%>

<div class="page-header">
  <div>
    <h1>Hello, <%= firstName %> 👋</h1>
    <p>Here's how your money is doing in <%= monthName %>.</p>
  </div>
  <div class="page-actions">
    <a href="/reports" class="btn btn-secondary"><i data-lucide="chart-pie"></i>Reports</a>
    <button type="button" class="btn btn-primary btn-add" data-add-tx><i data-lucide="plus"></i>Add transaction</button>
  </div>
</div>

<section class="grid grid-4" aria-label="Key numbers">
  <div class="card kpi kpi-hero">
    <div class="kpi-top"><span class="kpi-label">Total balance</span><span class="kpi-icon"><i data-lucide="wallet"></i></span></div>
    <div class="kpi-value"><%= fmt(allTime.net) %></div>
    <div class="kpi-sub">Across <%= allTime.count %> transaction<%= allTime.count === 1 ? '' : 's' %></div>
  </div>
  <div class="card kpi">
    <div class="kpi-top"><span class="kpi-label">Income this month</span><span class="kpi-icon tone-income"><i data-lucide="arrow-down-left"></i></span></div>
    <div class="kpi-value text-income"><%= fmt(thisMonth.income) %></div>
    <div class="kpi-sub"><%= monthName %></div>
  </div>
  <div class="card kpi">
    <div class="kpi-top"><span class="kpi-label">Spent this month</span><span class="kpi-icon tone-expense"><i data-lucide="arrow-up-right"></i></span></div>
    <div class="kpi-value text-expense"><%= fmt(thisMonth.expense) %></div>
    <div class="kpi-sub <%= monthlyBudget > 0 && thisMonth.expense > monthlyBudget ? 'text-expense' : '' %>">
      <% if (monthlyBudget > 0) { %>
        <%= Math.round(thisMonth.expense / monthlyBudget * 100) %>% of <%= fmt(monthlyBudget, { compact: true }) %> budget
      <% } else { %>
        <a href="/budgets">Set a monthly budget</a>
      <% } %>
    </div>
  </div>
  <div class="card kpi">
    <div class="kpi-top"><span class="kpi-label">Savings rate</span><span class="kpi-icon tone-primary"><i data-lucide="piggy-bank"></i></span></div>
    <div class="kpi-value"><%= savingsRate === null ? '—' : savingsRate + '%' %></div>
    <div class="kpi-sub">Saved <%= fmt(Math.max(0, thisMonth.net)) %> this month</div>
  </div>
</section>

<div class="grid grid-main mt-2">
  <div class="stack">
    <section class="card">
      <div class="card-header">
        <h2>Cash flow</h2>
        <span class="muted small">Last 6 months</span>
      </div>
      <div class="chart-box"><canvas data-chart="cashflow" aria-label="Income and expenses over the last 6 months" role="img"></canvas></div>
    </section>

    <section class="card card-flush">
      <div class="card-header">
        <h2>Recent transactions</h2>
        <a href="/transactions">View all</a>
      </div>
      <% if (recent.length) { %>
        <ul class="tx-list mt-1">
          <% recent.forEach(function (t) { %><%- include('partials/tx-item', { t: t, actions: true }) %><% }) %>
        </ul>
      <% } else { %>
        <div class="empty">
          <span class="kpi-icon tone-primary"><i data-lucide="receipt"></i></span>
          <h3>No transactions yet</h3>
          <p>Add your salary, a coffee, or import a bank CSV — your dashboard fills in automatically.</p>
          <div class="row">
            <button type="button" class="btn btn-primary" data-add-tx><i data-lucide="plus"></i>Add transaction</button>
            <a href="/transactions#import" class="btn btn-secondary"><i data-lucide="upload"></i>Import CSV</a>
          </div>
        </div>
      <% } %>
    </section>
  </div>

  <div class="stack">
    <% if (insights.length) { %>
      <section class="card">
        <div class="card-header"><h2>Insights</h2><i data-lucide="sparkles" class="muted"></i></div>
        <div class="insights">
          <% insights.forEach(function (i) { %>
            <div class="insight"><span class="kpi-icon tone-<%= i.tone %>"><i data-lucide="<%= i.icon %>"></i></span><p><%= i.text %></p></div>
          <% }) %>
        </div>
      </section>
    <% } %>

    <section class="card">
      <div class="card-header"><h2>Spending by category</h2><span class="muted small"><%= monthName.split(' ')[0] %></span></div>
      <% if (chart.categories.length) { %>
        <div class="chart-box sm"><canvas data-chart="categories" aria-label="Spending by category this month" role="img"></canvas></div>
        <div class="legend">
          <% chart.categories.slice(0, 5).forEach(function (c) { %>
            <div class="legend-item"><span class="legend-dot" style="background:<%= c.color %>"></span><span class="truncate"><%= c.label %></span><span class="val"><%= fmt(c.value) %></span></div>
          <% }) %>
        </div>
      <% } else { %>
        <p class="muted small">No spending recorded this month yet.</p>
      <% } %>
    </section>

    <section class="card">
      <div class="card-header"><h2>Budgets</h2><a href="/budgets">Manage</a></div>
      <% if (budgetRows.length) { %>
        <% budgetRows.forEach(function (b) { %>
          <div class="budget-item">
            <div class="row-between">
              <div class="row" style="gap:8px;min-width:0"><span class="cat-icon sm" style="--c:<%= b.meta.color %>"><i data-lucide="<%= b.meta.icon %>"></i></span><span class="truncate" style="font-weight:600;font-size:.9rem"><%= b.category %></span></div>
              <span class="small num nowrap"><strong><%= fmt(b.spent, { compact: true }) %></strong> <span class="muted">/ <%= fmt(b.amount, { compact: true }) %></span></span>
            </div>
            <div class="progress <%= barClass(b.pct) %>"><span style="width:<%= Math.min(100, b.pct) %>%"></span></div>
          </div>
        <% }) %>
      <% } else { %>
        <p class="muted small">Set spending limits per category and get warned before you overspend.</p>
        <a href="/budgets" class="btn btn-secondary btn-sm mt-1"><i data-lucide="plus"></i>Create a budget</a>
      <% } %>
    </section>

    <section class="card">
      <div class="card-header"><h2>Savings goals</h2><a href="/goals">All goals</a></div>
      <% if (goals.length) { %>
        <div class="stack" style="gap:14px">
          <% goals.forEach(function (g) { %>
            <div class="row">
              <div class="ring" style="--p:<%= Math.round(g.progress) %>;--c:<%= g.color %>;width:48px;height:48px"><span style="width:38px;height:38px;font-size:.7rem"><%= Math.round(g.progress) %>%</span></div>
              <div style="min-width:0;flex:1">
                <div class="truncate" style="font-weight:600"><%= g.name %></div>
                <div class="small muted num"><%= fmt(g.savedAmount) %> of <%= fmt(g.targetAmount) %></div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <p class="muted small">Saving for a laptop, a trip or an emergency fund? Track it here.</p>
        <a href="/goals" class="btn btn-secondary btn-sm mt-1"><i data-lucide="target"></i>Create a goal</a>
      <% } %>
    </section>

    <% if (upcoming.length) { %>
      <section class="card card-flush">
        <div class="card-header"><h2>Upcoming</h2><a href="/recurring">Recurring</a></div>
        <ul class="tx-list mt-1">
          <% upcoming.forEach(function (r) { %>
            <li class="tx-item">
              <span class="cat-icon sm" style="--c:<%= r.meta.color %>"><i data-lucide="<%= r.meta.icon %>"></i></span>
              <div class="tx-main"><div class="tx-title truncate"><%= r.note || r.category %></div><div class="tx-meta"><%= formatDate(r.nextDate, { day: 'numeric', month: 'short' }) %> · <%= r.frequency %></div></div>
              <div class="tx-amount small <%= r.type === 'income' ? 'text-income' : '' %>"><%= r.type === 'income' ? '+' : '−' %><%= fmt(r.amount) %></div>
            </li>
          <% }) %>
        </ul>
      </section>
    <% } %>
  </div>
</div>

<%- include('partials/app-end') %>
