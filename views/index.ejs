<%- include('partials/head', { extraCss: '/css/landing.css' }) %>
<body class="landing">
  <header class="l-nav">
    <div class="l-container">
      <a href="/" class="brand"><span class="brand-mark"><i data-lucide="chart-no-axes-combined"></i></span>FinTrac</a>
      <nav class="l-nav-links" aria-label="Account">
        <button type="button" class="icon-btn" data-theme-toggle aria-label="Toggle dark mode"><span data-theme-icon><i data-lucide="moon"></i></span></button>
        <a href="/auth/login" class="btn btn-ghost">Log in</a>
        <a href="/auth/register" class="btn btn-primary">Get started</a>
      </nav>
    </div>
  </header>

  <main>
    <section class="hero l-container">
      <span class="eyebrow"><i data-lucide="sparkles"></i>Budgets, goals, recurring bills &amp; reports</span>
      <h1>Take control of your money, <span class="grad">without the spreadsheet.</span></h1>
      <p class="sub">FinTrac helps students, young professionals and families track every expense, stick to a budget and reach savings goals — in a clean app that works on any device.</p>
      <div class="hero-ctas">
        <a href="/auth/register" class="btn btn-primary btn-lg">Start for free <i data-lucide="arrow-right"></i></a>
        <a href="/auth/login" class="btn btn-secondary btn-lg">I have an account</a>
      </div>
      <p class="hero-note">No credit card. No bank login. Your data stays yours — export it any time.</p>

      <div class="preview" aria-hidden="true">
        <div class="preview-inner">
          <div class="card kpi kpi-hero"><span class="kpi-label">Total balance</span><div class="kpi-value">₹84,250</div></div>
          <div class="card kpi"><span class="kpi-label">Income</span><div class="kpi-value text-income">₹62,000</div></div>
          <div class="card kpi"><span class="kpi-label">Spent</span><div class="kpi-value text-expense">₹31,480</div></div>
          <div class="card kpi"><span class="kpi-label">Savings rate</span><div class="kpi-value">49%</div></div>
          <div class="card preview-chart">
            <div class="row-between"><strong>Cash flow</strong><span class="small muted">Last 6 months</span></div>
            <div class="bars">
              <div><span class="i" style="height:70%"></span><span class="e" style="height:48%"></span></div>
              <div><span class="i" style="height:72%"></span><span class="e" style="height:60%"></span></div>
              <div><span class="i" style="height:68%"></span><span class="e" style="height:41%"></span></div>
              <div><span class="i" style="height:85%"></span><span class="e" style="height:52%"></span></div>
              <div><span class="i" style="height:80%"></span><span class="e" style="height:38%"></span></div>
              <div><span class="i" style="height:92%"></span><span class="e" style="height:46%"></span></div>
            </div>
          </div>
          <div class="card preview-side stack" style="gap:12px">
            <strong>Budgets</strong>
            <div><div class="row-between small"><span>Food</span><span class="muted">70%</span></div><div class="progress ok mt-1"><span style="width:70%"></span></div></div>
            <div><div class="row-between small"><span>Shopping</span><span class="muted">92%</span></div><div class="progress warn mt-1"><span style="width:92%"></span></div></div>
            <div><div class="row-between small"><span>Transport</span><span class="muted">35%</span></div><div class="progress ok mt-1"><span style="width:35%"></span></div></div>
          </div>
        </div>
      </div>
    </section>

    <section class="section l-container" id="features">
      <div class="section-head">
        <h2>Everything you need. Nothing you don't.</h2>
        <p>All the tools of a modern money app, designed to be understood in seconds.</p>
      </div>
      <div class="features">
        <div class="card feature"><span class="kpi-icon tone-primary"><i data-lucide="zap"></i></span><h3>Log in seconds</h3><p>Add income or expenses from anywhere with one tap — or press <kbd>N</kbd> on desktop.</p></div>
        <div class="card feature"><span class="kpi-icon tone-income"><i data-lucide="wallet"></i></span><h3>Smart budgets</h3><p>Monthly limits per category with daily allowance and alerts before you overspend.</p></div>
        <div class="card feature"><span class="kpi-icon tone-warning"><i data-lucide="target"></i></span><h3>Savings goals</h3><p>Set a target and a date — we tell you exactly how much to put aside each month.</p></div>
        <div class="card feature"><span class="kpi-icon tone-info"><i data-lucide="calendar-clock"></i></span><h3>Recurring bills</h3><p>Salary, rent and subscriptions are added automatically when they're due.</p></div>
        <div class="card feature"><span class="kpi-icon tone-expense"><i data-lucide="chart-pie"></i></span><h3>Clear reports</h3><p>Trends, category breakdowns, top expenses and period-over-period comparisons.</p></div>
        <div class="card feature"><span class="kpi-icon tone-primary"><i data-lucide="file-spreadsheet"></i></span><h3>Import &amp; export</h3><p>Bring in your bank's CSV and export everything to Excel or Google Sheets.</p></div>
      </div>
    </section>

    <section class="section l-container">
      <div class="section-head">
        <h2>Up and running in a minute</h2>
        <p>No setup wizard, no linking bank accounts.</p>
      </div>
      <div class="steps">
        <div class="card step"><h3>Create your free account</h3><p>Just a name, email and password. Pick your currency.</p></div>
        <div class="card step"><h3>Add what comes in and goes out</h3><p>Starter categories are ready. Add recurring items once and forget them.</p></div>
        <div class="card step"><h3>Watch your habits improve</h3><p>Budgets, goals and insights show exactly where you can save more.</p></div>
      </div>

      <div class="cta-band">
        <h2>Your future self will thank you.</h2>
        <p>Join FinTrac today and see where your money really goes.</p>
        <a href="/auth/register" class="btn btn-primary btn-lg">Create free account <i data-lucide="arrow-right"></i></a>
      </div>
    </section>
  </main>

  <footer class="l-footer">
    <div class="l-container">
      <span>&copy; <%= new Date().getFullYear() %> FinTrac · Empowering people to master their money.</span>
      <span class="row" style="gap:16px"><a href="/auth/login">Log in</a><a href="/auth/register">Sign up</a></span>
    </div>
  </footer>

  <script src="/vendor/lucide/lucide.min.js"></script>
  <script src="/js/app.js"></script>
</body>
</html>
