# MongoDB connection string (local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/fintrac

# Long random string used to sign session cookies. Required in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

PORT=3000

# Fallback timezone for "today" when the browser hasn't reported one yet
# (e.g. Asia/Kolkata). Defaults to UTC.
# APP_TIMEZONE=Asia/Kolkata
# NODE_ENV=production

# Public URL, used in password-reset emails (defaults to the request host)
# APP_URL=https://fintrac.example.com

# SMTP for password-reset emails. If unset, emails are printed to the console.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="FinTrac <no-reply@example.com>"
